# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Secrets live here only. The JSON files in config/ hold non-secret settings and
# are committed; a credential in one of those would be committed with it.

# --- Which environment ------------------------------------------------------
# dev | uat | prod. Printed at startup by every command -- an accidental PROD run
# against 8,000 databases is not a recoverable mistake.
MIGRATION_HUB_ENV=dev

# --- Moody's platform -------------------------------------------------------
# Prefer a dedicated service principal over a named user account: the migration
# runs unattended, and a personal account creates an audit and offboarding problem.
MOODYS_API_KEY=

# --- Registry ---------------------------------------------------------------
# SQLite (ADR-0007) -- the registry is one file, nothing to provision:
MIGRATION_HUB_DATABASE_URL=sqlite:///D:/MigrationHub/registry.db
#
# Or SQL Server, where an instance is available. Both are supported; the
# choice is this one setting.
# MIGRATION_HUB_DATABASE_URL=mssql+pyodbc://user:password@server/AML_MigHub?driver=ODBC+Driver+18+for+SQL+Server

# Keep the SQLite file on LOCAL disk. On a network share or inside a sync
# folder (OneDrive, SharePoint, Dropbox) SQLite corrupts: file locking is
# unreliable, WAL may be unavailable, and a sync client rewriting the file
# from another process gives a torn write. The failure is a corrupted
# registry rather than an error.
#
# Startup refuses such a path unless this is set. Set it only knowingly --
# and if you do, back the file up regularly and run a single worker.
#
# MS Amlin's current deployment DOES set this: the registry lives under a
# OneDrive SharePoint shortcut, accepted 2026-09-19. Startup logs which
# journal mode SQLite actually granted, so the degradation is visible rather
# than assumed.
# MIGRATION_HUB_ALLOW_NETWORK_REGISTRY=yes

# BACKING UP THE REGISTRY. It is the record of what moved -- losing it mid-wave
# is an audit gap, not a restart. Copy it on a schedule to somewhere other than
# the machine that wrote it.
#
# Use VACUUM INTO rather than a file copy. A plain copy of a SQLite file that
# is being written can be torn; VACUUM INTO takes a consistent snapshot of a
# live database:
#
#     sqlite3 registry.db "VACUUM INTO 'X:/backups/registry-2026-09-19.db'"
#
# The sync folder or network share is a perfectly good DESTINATION for that
# backup -- it is only running the live registry there that corrupts.

# --- Optional: proxy --------------------------------------------------------
# Must permit BOTH the Moody's API host and the AWS S3 endpoints. They are
# different hosts; rules covering only the former fail at the upload step.
# HTTPS_PROXY=
# NO_PROXY=
